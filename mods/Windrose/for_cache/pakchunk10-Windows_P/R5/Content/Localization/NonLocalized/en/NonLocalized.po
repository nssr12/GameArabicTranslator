msgctxt ",0E67476A453E2122B62CD586035B326D"
msgid "Кому ты сдался. <T_GRAY>[Уйти]</>"
msgstr "Кому ты сдался. <T_GRAY>[Уйти]</>"

#. Key:	0F8677774B10C62429B6F498D212CE6D
