msgctxt ",B3E915CB474D3707A1AF55BC8B0E1D55"
msgid "Похоже, не получилось ни то, ни другое."
msgstr "Похоже, не получилось ни то, ни другое."

#. Key:	BB04F3314395558615F39AA15B35979D
#. SourceLocation:	/Game/Gameplay/Scenario/NPC/Ksant/SC_ScSubGraph_NPC_Ksant_Question_02.SC_ScSubGraph_NPC_Ksant_Question_02_C:ExecuteUbergraph_SC_ScSubGraph_NPC_Ksant_Question_02 [Script Bytecode]
#: /Game/Gameplay/Scenario/NPC/Ksant/SC_ScSubGraph_NPC_Ksant_Question_02.SC_ScSubGraph_NPC_Ksant_Question_02_C:ExecuteUbergraph_SC_ScSubGraph_NPC_Ksant_Question_02 [Script Bytecode]
msgctxt ",BB04F3314395558615F39AA15B35979D"
msgid "Они считали, что это место ближе всего находится ко входу в мир мертвых и хоронили тут своих мертвецов."
msgstr "Они считали, что это место ближе всего находится ко входу в мир мертвых и хоронили тут своих мертвецов."

#. Key:	DD605DC64868C922353E848B8A3BAF63
#. SourceLocation:	/Game/Gameplay/Scenario/NPC/Ksant/SC_ScSubGraph_NPC_Ksant_Question_02.SC_ScSubGraph_NPC_Ksant_Question_02_C:ExecuteUbergraph_SC_ScSubGraph_NPC_Ksant_Question_02 [Script Bytecode]
