msgctxt ",80595FBD4CD228A9EF52B9B35447FF37"
msgid "Говорила мама, надо становится священником. Сидел бы сейчас в собственном приходе и набивал пузо, а не подыхал среди мертвецов и обломков..."
msgstr "Говорила мама, надо становится священником. Сидел бы сейчас в собственном приходе и набивал пузо, а не подыхал среди мертвецов и обломков..."

#. Key:	909FB6074CD7095CE812B69D615225F6
#. SourceLocation:	/Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
