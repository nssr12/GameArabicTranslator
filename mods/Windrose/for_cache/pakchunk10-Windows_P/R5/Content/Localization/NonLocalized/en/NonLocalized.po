msgctxt ",5A0E294046501D440FC4EFB73974AABD"
msgid "Как найти Хендса? <img id=\"Quest\"/>"
msgstr "Как найти Хендса? <img id=\"Quest\"/>"

#. Key:	5E07C5F54A1A16FAB7C6278B7030154A
#. SourceLocation:	/Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
#: /Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
msgctxt ",5E07C5F54A1A16FAB7C6278B7030154A"
msgid "Я его освободить хотел, да пришел – а клетка пустая. Подумал, его утопцы пришибли."
msgstr "Я его освободить хотел, да пришел – а клетка пустая. Подумал, его утопцы пришибли."

#. Key:	6260F6D34C788547DF8C948F62037F81
#. SourceLocation:	/Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
