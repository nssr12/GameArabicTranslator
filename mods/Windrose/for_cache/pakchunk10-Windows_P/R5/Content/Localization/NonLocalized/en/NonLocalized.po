msgctxt ",4D60A13E4D6DA7FEC369BF809608945D"
msgid "Как выбраться с архипелага? <img id=\"Quest\"/>"
msgstr "Как выбраться с архипелага? <img id=\"Quest\"/>"

#. Key:	4DC43B704E885DB5A8F05799C186C9D5
#. SourceLocation:	/Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
