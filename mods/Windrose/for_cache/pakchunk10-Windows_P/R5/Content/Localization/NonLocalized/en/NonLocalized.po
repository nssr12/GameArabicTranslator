msgctxt ",A92C85B644110EC6F3F5A7BA8ED01763"
msgid "Поэтому твари так расплодились. В топях должны сохраниться остатки некрополей. "
msgstr "Поэтому твари так расплодились. В топях должны сохраниться остатки некрополей. "

#. Key:	B3E915CB474D3707A1AF55BC8B0E1D55
#. SourceLocation:	/Game/Gameplay/Scenario/NPC/Ksant/SC_ScSubGraph_NPC_Ksant_Question_02.SC_ScSubGraph_NPC_Ksant_Question_02_C:ExecuteUbergraph_SC_ScSubGraph_NPC_Ksant_Question_02 [Script Bytecode]
