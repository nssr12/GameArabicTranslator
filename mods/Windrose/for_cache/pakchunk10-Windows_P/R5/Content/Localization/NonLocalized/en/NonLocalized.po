msgctxt ",7FEEF6F2406871B916A256BA39DCE056"
msgid "Наверняка жрица приползла сюда, чтобы вымаливать прощение для своего народа и вырвать своего убитого бога из лап смерти."
msgstr "Наверняка жрица приползла сюда, чтобы вымаливать прощение для своего народа и вырвать своего убитого бога из лап смерти."

#. Key:	8BF4921545A22998261E9888F3CC0B2B
#. SourceLocation:	/Game/Gameplay/Scenario/NPC/Ksant/SC_ScSubGraph_NPC_Ksant_Question_02.SC_ScSubGraph_NPC_Ksant_Question_02_C:ExecuteUbergraph_SC_ScSubGraph_NPC_Ksant_Question_02 [Script Bytecode]
