msgctxt ",08442B07475C517469E03FA7A1BF6AFD"
msgid "Думаешь, мы просто так на ваш корабль напали? Думаешь, че в Лондон вез, а? Дорогой трофей, который благородные павлины выставят в своих гостиных?"
msgstr "Думаешь, мы просто так на ваш корабль напали? Думаешь, че в Лондон вез, а? Дорогой трофей, который благородные павлины выставят в своих гостиных?"

#. Key:	0D1515FB4FFCBE5116A264978147E10D
#. SourceLocation:	/Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
