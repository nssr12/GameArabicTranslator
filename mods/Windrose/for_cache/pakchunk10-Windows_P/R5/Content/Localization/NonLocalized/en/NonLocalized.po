msgctxt ",45C0AE34469CAD26D1CC8B878140F1EE"
msgid "Я один раз подглядел – едва в штаны не наложил: он души неупокоенные вызывал. Я как это увидел, так и дал деру."
msgstr "Я один раз подглядел – едва в штаны не наложил: он души неупокоенные вызывал. Я как это увидел, так и дал деру."

#. Key:	47AA38B9487967129383FF9520D88EB0
#. SourceLocation:	/Game/Gameplay/Scenario/POI/BossArena/Boatswain/SideScenarios/SC_ScGraph_Dialogue_ScaredBlackbeard_01.SC_ScGraph_Dialogue_ScaredBlackbeard_01_C:ExecuteUbergraph_SC_ScGraph_Dialogue_ScaredBlackbeard_01 [Script Bytecode]
