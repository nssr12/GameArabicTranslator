msgctxt ",E7C25A8D4A46FAD3299CC2ADF90AF4AD"
msgid "Осторожнее: в Старом Свете за такие речи можно лишиться головы. Или слегка поджариться."
msgstr "Осторожнее: в Старом Свете за такие речи можно лишиться головы. Или слегка поджариться."

#. Key:	E94C9C6042311D2E8F0A4EB0531CDD00
#. SourceLocation:	/Game/Gameplay/Scenario/NPC/Ksant/SC_ScSubGraph_NPC_Ksant_Question_02.SC_ScSubGraph_NPC_Ksant_Question_02_C:ExecuteUbergraph_SC_ScSubGraph_NPC_Ksant_Question_02 [Script Bytecode]
