#. Key:	Building_Bedroll01_Description
#. SourceLocation:	Localization/Data/BuildingItems.csv
#. InfoMetaData:	"Context" : "Cпальное место. Лучше чем ничего\r\n\r\nПозволяет сохранять точку возрождения\r\n\r\nТребует крышу\r\nКомфорт +1"
#: Localization/Data/BuildingItems.csv
msgctxt "BuildingItems,Building_Bedroll01_Description"
msgid "Cпальное место. Лучше чем ничего\r\n\r\nПозволяет сохранять точку возрождения\r\n\r\nТребует крышу\r\n\r\nКомфорт +1\r\nБонусы комфорта в категории не суммируются"
msgstr "Sleeping spot. Better than nothing.\r\n\r\nAllows to set your revival point.\r\n\r\nRequires a roof.\r\n\r\nComfort +1\r\nComfort bonuses in this category do not stack"

#. Key:	Building_Bedroll01_Name
#. SourceLocation:	Localization/Data/BuildingItems.csv
#. InfoMetaData:	"Context" : "Простая кровать"
#: Localization/Data/BuildingItems.csv
msgctxt "BuildingItems,Building_Bedroll01_Name"
msgid "Простая кровать"
msgstr "Simple Bed"

#. Key:	Building_Bedroll02_Description
#. SourceLocation:	Localization/Data/BuildingItems.csv
#: Localization/Data/BuildingItems.csv
msgctxt "BuildingItems,Building_Bedroll02_Description"
msgid "Простая кровать с украшенным изголовьем\r\n\r\nПозволяет сохранять точку возрождения\r\n\r\nТребует крышу\r\n\r\nКомфорт +2\r\nБонусы комфорта в категории не суммируются"
msgstr "Simple bed with a decorated headboard\r\n\r\nAllows to set your revival point.\r\n\r\nRequires a roof.\r\n\r\nComfort +2\r\nComfort bonuses in this category do not stack"

#. Key:	Building_Bedroll02_Name
