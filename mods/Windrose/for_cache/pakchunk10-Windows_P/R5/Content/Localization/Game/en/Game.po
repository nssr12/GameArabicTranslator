msgctxt "InventoryItems,CID_Alchemy_Bandages_T01_ItemDescription"
msgid "Грубый лоскут материи, пропитанный морской водой."
msgstr "A rough scrap of cloth soaked in seawater."

#. Key:	CID_Alchemy_Bandages_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Bandages_T01_ItemName"
