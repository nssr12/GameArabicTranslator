#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_CritDamage_ExtraDuration_ItemName"
msgid "Infused Elixir of Concentration"
msgstr "Infused Elixir of Concentration"

#. Key:	CID_Alchemy_Elixir_CritDamage_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_CritDamage_ItemDescription"
msgid "Желтоватый светящийся настой с соленым привкусом. Уже после первого глотка на окружающих начинают мерещиться пятна, будто подсказывая, куда им надо вмазать."
msgstr "A yellowish, glowing draught with a salty bite. One sip, and spots appear on everyone around you—apparently to make hitting them easier."

#. Key:	CID_Alchemy_Elixir_CritDamage_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_CritDamage_ItemName"
msgid "Эликсир Концентрации"
msgstr "Elixir of Concentration"

#. Key:	CID_Alchemy_Elixir_CritDamage_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_CritDamage_VanityText"
msgid "Плод омерзительных религиозных практик давно погибшего племени"
msgstr "The product of vile religious rites practiced by a long-dead tribe."

#. Key:	CID_Alchemy_Elixir_DamageResist_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_DamageResist_Effect1"
msgid "Increases Damage Resistance by {1}."
msgstr "Increases Damage Resistance by {1}."

#. Key:	CID_Alchemy_Elixir_DamageResist_Effect2
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_DamageResist_Effect2"
msgid "Lasts for {0} min."
msgstr "Lasts for {0} min."

#. Key:	CID_Alchemy_Elixir_DamageResist_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_DamageResist_ItemDescription"
msgid "Холодный желеобразный настой с ужасным запахом дикого козла. Достаточно понюхать и сразу чувствуешь как немеют пальцы на ногах. Алхимики до сих пор спорят, стоит ли его вообще пить."
msgstr "A cold, jelly-like draught that reeks of wild goat. One sniff and your toes go numb. Alchemists still argue whether it should be drunk at all."

#. Key:	CID_Alchemy_Elixir_DamageResist_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_DamageResist_ItemName"
msgid "Эликсир Притупления боли"
msgstr "Elixir of Pain Relief"

#. Key:	CID_Alchemy_Elixir_DamageResist_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_DamageResist_VanityText"
msgid "Боль напоминает о том, что мы живы. Вот когда ничего не болит, тогда можно паниковать.\r\n— доктор Гален Скелтон"
msgstr "Pain reminds us we are alive. When nothing hurts, that is when you should panic.\r\n— Doctor Galen Skelton"

#. Key:	CID_Alchemy_Elixir_GlobalDamage_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_GlobalDamage_Effect1"
msgid "Increases Damage by {1}."
msgstr "Increases Damage by {1}."

#. Key:	CID_Alchemy_Elixir_GlobalDamage_Effect2
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_GlobalDamage_Effect2"
msgid "Lasts for {0} min."
msgstr "Lasts for {0} min."

#. Key:	CID_Alchemy_Elixir_GlobalDamage_ExtraDuration_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_GlobalDamage_ExtraDuration_ItemName"
msgid "Infused Elixir of Cruelty"
msgstr "Infused Elixir of Cruelty"

#. Key:	CID_Alchemy_Elixir_GlobalDamage_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_GlobalDamage_ItemDescription"
msgid "Густой фиолетовый эликсир с резким пряным ароматом. Пробуждает жестокость, делая каждый удар тяжелее и беспощаднее."
msgstr "A thick purple elixir with a sharp, spicy scent. It rouses cruelty, making every blow heavier and more merciless."

#. Key:	CID_Alchemy_Elixir_GlobalDamage_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_GlobalDamage_ItemName"
msgid "Эликсир Жестокости"
msgstr "Elixir of Cruelty"

#. Key:	CID_Alchemy_Elixir_GlobalDamage_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_GlobalDamage_VanityText"
msgid "Жестокость — не порок.\r\n— Эдвард \"Черная Борода\" Тич"
msgstr "Cruelty is not a vice.\r\n— Edward “Blackbeard” Teach"

#. Key:	CID_Alchemy_Elixir_MeleeDamage_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_MeleeDamage_Effect1"
msgid "Increases Melee Damage by {1}."
msgstr "Increases Melee Damage by {1}."

#. Key:	CID_Alchemy_Elixir_MeleeDamage_Effect2
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_MeleeDamage_Effect2"
msgid "Lasts for {0} min."
msgstr "Lasts for {0} min."

#. Key:	CID_Alchemy_Elixir_MeleeDamage_ExtraDuration_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_MeleeDamage_ExtraDuration_ItemName"
msgid "Infused Elixir of Firm Hand"
msgstr "Infused Elixir of Firm Hand"

#. Key:	CID_Alchemy_Elixir_MeleeDamage_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_MeleeDamage_ItemDescription"
msgid "Оранжевый эликсир с густым осадком на дне бутылки, практически без вкуса и запаха. Выпив его - тело наливается силой, челюсть сводит, говорить становится трудно — зато саблей махать самое то."
msgstr "An orange elixir with heavy sediment at the bottom, with almost no taste or smell. Drink it and your body swells with strength, your jaw clenches, and speech comes hard, but your saber arm will thank you."

#. Key:	CID_Alchemy_Elixir_MeleeDamage_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_MeleeDamage_ItemName"
msgid "Эликсир Твердой руки"
msgstr "Elixir of Firm Hand"

#. Key:	CID_Alchemy_Elixir_MeleeDamage_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_MeleeDamage_VanityText"
msgid "В ближнем бою побеждает не тот, кто быстрее, а тот, кто не передумал.\r\n— доктор Гален Скелтон"
msgstr "In close combat, the victor is not the swiftest, but the one who does not falter. \r\n— Doctor Galen Skelton"

#. Key:	CID_Alchemy_Elixir_RangeDamage_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_RangeDamage_Effect1"
msgid "Increases Ranged Damage by {1}."
msgstr "Increases Ranged Damage by {1}."

#. Key:	CID_Alchemy_Elixir_RangeDamage_Effect2
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_RangeDamage_Effect2"
msgid "Lasts for {0} min."
msgstr "Lasts for {0} min."

#. Key:	CID_Alchemy_Elixir_RangeDamage_ExtraDuration_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_RangeDamage_ExtraDuration_ItemName"
msgid "Infused Elixir of Precision"
msgstr "Infused Elixir of Precision"

#. Key:	CID_Alchemy_Elixir_RangeDamage_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_RangeDamage_ItemDescription"
msgid "Мутная зеленая настойка на волчьих клыках. Считается, что если после бурной ночи, перед сном положить под язык клык собаки, то на утро не будут трястись руки. Буканьеры архипелага развили эту идею и придумали такой эликсир в надежде сэкономить на пулях."
msgstr "A stark green draught steeped in wolf fangs. They say that if, after a hard night, you place a dog’s fang under your tongue before sleep, your hands won’t shake come morning. The buccaneers of the archipelago took the idea further and brewed this elixir, hoping to save on bullets."

#. Key:	CID_Alchemy_Elixir_RangeDamage_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_RangeDamage_ItemName"
msgid "Эликсир Меткости"
msgstr "Elixir of Precision"

#. Key:	CID_Alchemy_Elixir_RangeDamage_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Elixir_RangeDamage_VanityText"
msgid "Если промахнулся – значит, это была не цель, а приманка!\r\n— Марсель Буше, буканьер"
msgstr "If you missed, it wasn’t the target—it was bait!\r\n— Marcel Boucher, buccaneer"

#. Key:	CID_Alchemy_Potion_EnhancedHealing_T01_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_EnhancedHealing_T01_Effect1"
msgid "Instantly restores {0} Health."
msgstr "Instantly restores {0} Health."

#. Key:	CID_Alchemy_Potion_EnhancedHealing_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_EnhancedHealing_T01_ItemDescription"
msgid "Лечит раны и притупляет боль, позволяя продолжить бой с новыми силами."
msgstr "Heals serious wounds and dulls the pain. Not a miracle in a bottle, but it does the job."

#. Key:	CID_Alchemy_Potion_EnhancedHealing_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_EnhancedHealing_T01_ItemName"
msgid "Средняя микстура лечения"
msgstr "Healing Potion"

#. Key:	CID_Alchemy_Potion_EnhancedHealing_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_EnhancedHealing_T01_VanityText"
msgid "When death is looming, you have to use any means available. Just don't think about what it's made of."
msgstr "To die would be an awfully big adventure."

#. Key:	CID_Alchemy_Potion_GreatHealing_T01_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_GreatHealing_T01_Effect1"
msgid "Instantly restores {0} Health."
msgstr "Instantly restores {0} Health."

#. Key:	CID_Alchemy_Potion_GreatHealing_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_GreatHealing_T01_ItemDescription"
msgid "Восстанавливает силы и залечивает даже самые глубокие раны."
msgstr "Restores your strength and heals even the deepest wounds."

#. Key:	CID_Alchemy_Potion_GreatHealing_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_GreatHealing_T01_ItemName"
msgid "Великая микстура лечения"
msgstr "Great Healing Potion"

#. Key:	CID_Alchemy_Potion_GreatHealing_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_GreatHealing_T01_VanityText"
msgid "Говорят, эта микстура вытаскивает моряков прямо из рундука Дейви Джонса."
msgstr "They say this mixture hauls sailors straight out of Davy Jones’ locker."

#. Key:	CID_Alchemy_Potion_Healing_T01_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Healing_T01_Effect1"
msgid "Instantly restores {0} Health."
msgstr "Instantly restores {0} Health."

#. Key:	CID_Alchemy_Potion_Healing_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Healing_T01_ItemDescription"
msgid "Быстро залечивает мелкие порезы и снимает боль, даруя силы для боя... или бегства."
msgstr "Quickly mends small cuts and dulls the pain, giving you the strength to fight… or flee."

#. Key:	CID_Alchemy_Potion_Healing_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Healing_T01_ItemName"
msgid "Малая микстура лечения"
msgstr "Minor Healing Potion"

#. Key:	CID_Alchemy_Potion_Healing_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Healing_T01_VanityText"
msgid "Не стоит безоглядно доверять зельям. Постельный режим и покой для исцеления необходимы не меньше.\r\n— доктор Гален Скелтон"
msgstr "Do not trust potions blindly. Bed rest and peace and quiet are just as necessary for healing.\r\n— Doctor Galen Skelton"

#. Key:	CID_Alchemy_Potion_Recall_T01_Effect1
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Recall_T01_Effect1"
msgid "Returns you to the last revival point."
msgstr "Returns you to the last revival point."

#. Key:	CID_Alchemy_Potion_Recall_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Recall_T01_ItemDescription"
msgid "Легкий напиток со сладковатым вкусом. Жалко только, приготовить его непросто – нужны редкие ингредиенты."
msgstr "A light drink with a slightly sweet taste. Too bad it isn’t easy to make—rare ingredients are required."

#. Key:	CID_Alchemy_Potion_Recall_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Recall_T01_ItemName"
msgid "Дорога домой"
msgstr "Homeward Journey"

#. Key:	CID_Alchemy_Potion_Recall_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Alchemy_Potion_Recall_T01_VanityText"
msgid "Мгновенное перемещение из ночного трактира в залитую потом кровать – магия, доступная только самым опытным чародеям Тортуги."
msgstr "To leave a midnight tavern and wake up in a sweat-soaked bed with no idea how you got there—that’s magic practiced only by Tortuga’s most seasoned ‘wizards.’"

#. Key:	CID_Food_Dough_BurritoBeans_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_BurritoBeans_T03_ItemDescription"
msgid "Кукурузная лепешка с фасолью в томатном соусе.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Corn tortilla with beans in tomato sauce.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Dough_BurritoBeans_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_BurritoBeans_T03_ItemName"
msgid "Тако"
msgstr "Taco"

#. Key:	CID_Food_Dough_BurritoBeans_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_BurritoBeans_T03_VanityText"
msgid "Капитан говорил, что если выпить бутылку рома и закусить тако, можно услышать пение сирен. Никто не смог убедить его, что дело не в закуске.\r\n— корабельный кок \"Одноглазый\" Аксель"
msgstr "The captain used to swear that a bottle of rum, chased with a taco, lets you hear the sirens sing. No one could convince him it wasn’t the taco.\r\n— Black Axel, cook"

#. Key:	CID_Food_Dough_BurritoMeat_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_BurritoMeat_T02_ItemDescription"
msgid "Этот плотный сверток из нежной кукурузной лепешки наполнен рубленым мясом и специями.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A hearty wrap of tender corn tortilla, stuffed with chopped meat and spices.\r\n\r\nIncreases maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Dough_BurritoMeat_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_BurritoMeat_T02_ItemName"
msgid "Буррито"
msgstr "Burrito"

#. Key:	CID_Food_Dough_BurritoMeat_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_BurritoMeat_T02_VanityText"
msgid "Один укус – и морская буря покажется легким бризом."
msgstr "One bite, and a sea storm will feel like a light breeze."

#. Key:	CID_Food_Dough_CornCasabe_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_CornCasabe_T02_ItemDescription"
msgid "Тонкая кукурузная лепешка. Полностью голод не утолит, но набьет брюхо.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A thin corn tortilla. Not a feast, but enough to quiet a growling stomach.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Dough_CornCasabe_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_CornCasabe_T02_ItemName"
msgid "Тортилья"
msgstr "Tortilla"

#. Key:	CID_Food_Dough_CornCasabe_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_CornCasabe_T02_VanityText"
msgid "Не заметишь, как съешь целую гору и попросишь еще."
msgstr "Before you know it, you will devour a whole stack and ask for more."

#. Key:	CID_Food_Dough_Pastechi_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_Pastechi_T02_ItemDescription"
msgid "Обжаренное кукурузное тесто с мясной начинкой внутри. Традиционная закуска на островах Аруба, Бонэйр и Кюрасао.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Fried corn dough with a meat filling inside. A traditional appetizer on the islands of Aruba, Bonaire and Curaçao.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Dough_Pastechi_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_Pastechi_T02_ItemName"
msgid "Пастечи"
msgstr "Pastechi"

#. Key:	CID_Food_Dough_Pastechi_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_Pastechi_T02_VanityText"
msgid "На каждом корабле в каждом рейде обязательно найдется  идиот, который будет доказывать, что пастечи с картошкой лучше.\r\n— корабельный кок \"Одноглазый\" Аксель"
msgstr "On every ship, on every raid, there is bound to be some fool who swears pastechi with potatoes is better.\r\n— Black Axel, cook"

#. Key:	CID_Food_Dough_Tamale_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_Tamale_T03_ItemDescription"
msgid "Кукурузное тесто с начинкой, обернутое кукурузными листьями и приготовленное на пару. Мясо крокодила делает блюдо особенно сытным.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Corn dough with filling, wrapped in corn husks and steamed. Crocodile meat makes it especially hearty.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Dough_Tamale_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_Tamale_T03_ItemName"
msgid "Тамале"
msgstr "Tamale"

#. Key:	CID_Food_Dough_Tamale_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_Tamale_T03_VanityText"
msgid "Считается, что именно тамале гостеприимные индейцы предлагали попробовать прибывшим на запад конкистадорам. И, на свою беду, даже не добавили яду."
msgstr "They say hospitable locals once offered tamale to the conquistadors who came west. To their own misfortune, they did not even add poison."

#. Key:	CID_Food_Dough_WineMeat_T04_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_WineMeat_T04_ItemDescription"
msgid "Нежное мясо, томленное в винном соусе с томатами, словно добыча, отбитая у испанского галеона. Подается только тем, кто не боится облизать клинок!\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Tender meat simmered in wine sauce with tomatoes, like booty taken from a Spanish galleon. Served only to those unafraid to lick the blade.\r\n\r\nIncreases Maximum Health\r\nLasts {0} minutes."

#. Key:	CID_Food_Dough_WineMeat_T04_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Dough_WineMeat_T04_ItemName"
msgid "Мясо в винном соусе с томатами"
msgstr "Meat in Tomato-Wine Sauce"

#. Key:	CID_Food_Drink_ChichaMorada_T04_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_ChichaMorada_T04_ItemDescription"
msgid "Добыто у бесжалостных аборигенов, приправлено жуткими легендами, выпито… очень быстро\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Taken from ruthless locals, seasoned with grim legends, downed… very quickly.\r\n\r\nIncreases Maximum Health\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_ChichaMorada_T04_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_ChichaMorada_T04_ItemName"
msgid "Чича морада"
msgstr "Chicha morada"

#. Key:	CID_Food_Drink_Coconana_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_Coconana_T01_ItemDescription"
msgid "Освежающий напиток, приготовленный из кокосового молока и спелых бананов. Утоляет жажду и придает сил для долгих сражений под палящим солнцем.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A refreshing drink of coconut milk and ripe bananas. Quenches thirst and lends strength for long fights beneath a scorching sun.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_Coconana_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_Coconana_T01_ItemName"
msgid "Кокосовое молоко с бананом"
msgstr "Coconut Milk With Bananas"

#. Key:	CID_Food_Drink_Coconana_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_Coconana_T01_VanityText"
msgid "Глоток райского наслаждения."
msgstr "A sip of pure paradise."

#. Key:	CID_Food_Drink_CocoPeanut_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_CocoPeanut_T02_ItemDescription"
msgid "Этот целебный напиток сочетает в себе кокосовое молоко, мякоть алоэ и хрустящие жареные орехи.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A healing drink of coconut milk, aloe pulp, and crunchy roasted nuts.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_CocoPeanut_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_CocoPeanut_T02_ItemName"
msgid "Освежающий напиток с орехами"
msgstr "Sunmilk Tonic"

#. Key:	CID_Food_Drink_CocoPeanut_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_CocoPeanut_T02_VanityText"
msgid "Орехи в соке? Несусветная ересь!\r\n— святой отец Игнасио"
msgstr "Nuts in a drink? Unthinkable blasphemy!\r\n— Reverend Father Ignacio"

#. Key:	CID_Food_Drink_Coffee_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_Coffee_T03_ItemDescription"
msgid "Универсальное человеческое топливо. Позволяет протянуть еще пару часов после заката... и не застрелиться с утра.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "All-purpose human fuel. Helps you last a few hours past sundown—and keeps you from putting a bullet in your head come morning.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_Coffee_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_Coffee_T03_ItemName"
msgid "Кофе"
msgstr "Coffee"

#. Key:	CID_Food_Drink_Coffee_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_Coffee_T03_VanityText"
msgid "Любовь как кофе: может быть сладкой, может быть горькой, но в больших дозах смертельно опасна.\r\n— доктор Гален Скелтон"
msgstr "Love is like coffee: it can be sweet, it can be bitter, and in large doses, it can be lethal. \r\n— Doctor Galen Skelton"

#. Key:	CID_Food_Drink_CoffeeBanana_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_CoffeeBanana_T03_ItemDescription"
msgid "Для максимального раскрытия вкуса лучше использовать кофе, поставляемый из испанских колоний Южной Америки, и только спелые бананы.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "For the best flavor, use coffee imported from the Spanish colonies of South America and only ripe bananas.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_CoffeeBanana_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_CoffeeBanana_T03_ItemName"
msgid "Кофе с бананом"
msgstr "Banana Coffee"

#. Key:	CID_Food_Drink_CoffeeBanana_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_CoffeeBanana_T03_VanityText"
msgid "Изысканное извращение для истинных ценителей.\r\n— сэр Гектор Мейфилд, глава экспедиции Британской Ост-Индской компании в Вест-Индии"
msgstr "An exquisite perversion for true connoisseurs.\r\n— Sir Hector Mayfield, head of the British East India Company expedition to the West Indies"

#. Key:	CID_Food_Drink_IcacoCoco_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_IcacoCoco_T03_ItemDescription"
msgid "Легкий напиток с пряным вкусом. Позволяет дольше убегать от крокодилов по топям.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A light drink with a spicy bite. Helps you outrun crocodiles in the swamps for longer.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_IcacoCoco_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_IcacoCoco_T03_ItemName"
msgid "Пряный болотный сок"
msgstr "Spicy Swamp Juice"

#. Key:	CID_Food_Drink_IcacoCoco_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_IcacoCoco_T03_VanityText"
msgid "Одни говорят, что он исцеляет усталось, другие – что пробуждает дьявола в крови. Истина, как всегда, где-то посередине."
msgstr "Some say it cures fatigue, others say it wakes the devil in your blood. As ever, the truth lies somewhere between."

#. Key:	CID_Food_Drink_SourTomato_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_SourTomato_T02_ItemDescription"
msgid "Ярко-красный напиток, приготовленный из спелых томатов.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Made from ripe tomatoes, this bold red drink is full of flavour.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_SourTomato_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_SourTomato_T02_ItemName"
msgid "Освежающий томатный сок"
msgstr "Refreshing Tomato Juice"

#. Key:	CID_Food_Drink_SourTomato_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_SourTomato_T02_VanityText"
msgid "Вкус – на любителя, цвет и запах – тоже. С солью и ромом должно быть получше."
msgstr "An acquired taste. The color and smell aren’t doing it any favors either. Salt and rum might help."

#. Key:	CID_Food_Drink_SweetLime_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_SweetLime_T02_ItemDescription"
msgid "Кисло-сладкий напиток, приготовленный из свежевыжатого лаймового сока и тростникового сахара.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A sweet and sour drink made from freshly squeezed lime juice and cane sugar.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Drink_SweetLime_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_SweetLime_T02_ItemName"
msgid "Сладкий сок лайма"
msgstr "Sweet Lime Juice"

#. Key:	CID_Food_Drink_SweetLime_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Drink_SweetLime_T02_VanityText"
msgid "Слишком сладкий для боцмана, слишком кислый для кока, но для юнги в самый раз."
msgstr "Too sweet for the bosun, too sour for the cook, but just right for a cabin boy."

#. Key:	CID_Food_Raw_Banana_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Banana_T01_ItemDescription"
msgid "Сладкий плод. Растет в Прибрежных Джунглях.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A sweet fruit. Found in the Coastal Jungle.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Banana_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Banana_T01_ItemName"
msgid "Банан"
msgstr "Banana"

#. Key:	CID_Food_Raw_Coconut_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Coconut_T01_ItemDescription"
msgid "Можно найти на пляже и на пальмах вдоль пляжа в Прибрежных Джунглях.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Found on the beach, and on palm trees along the shore in the Coastal Jungle.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Coconut_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Coconut_T01_ItemName"
msgid "Кокос"
msgstr "Coconut"

#. Key:	CID_Food_Raw_Corn_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Corn_T02_ItemDescription"
msgid "Свежая кукуруза. Ее можно толочь, жарить, варить, мариновать, запекать, добавлять в другие блюда... и это даже не полный список.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Fresh corn. It can be ground, roasted, boiled, pickled, baked, added to other dishes—and that’s not even the full list.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Corn_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Corn_T02_ItemName"
msgid "Кукуруза"
msgstr "Corn"

#. Key:	CID_Food_Raw_Grapes_T04_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Grapes_T04_ItemName"
msgid "Виноград"
msgstr "Grape"

#. Key:	CID_Food_Raw_Icaco_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Icaco_T03_ItemDescription"
msgid "Болотная слива. Растет, как нетрудно догадаться, в Болотах.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Cocoplum. Grows in the Swamps.\r\n\r\nIncreases Maximum Health\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Icaco_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Icaco_T03_ItemName"
msgid "Икако"
msgstr "Cocoplum"

#. Key:	CID_Food_Raw_Lime_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Lime_T02_ItemDescription"
msgid "Растет в Предгорьях.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Grows in the Foothills.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Lime_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Lime_T02_ItemName"
msgid "Лайм"
msgstr "Lime"

#. Key:	CID_Food_Raw_Lime_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Lime_T02_VanityText"
msgid "Лучшее средство от цинги."
msgstr "The best remedy for scurvy."

#. Key:	CID_Food_Raw_Pepper_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Pepper_T01_ItemDescription"
msgid "Крупные хрустящие перцы, которые используют в качестве приправы в различных рецептах. С ними вкус блюд становится богаче и острее. Главное -- знать меру.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Large, crisp peppers used to season many a dish. They make the flavor richer—and the bite hotter. Just don’t overdo it.\r\n\r\nGrows in the Coastal Jungle.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Pepper_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Pepper_T01_ItemName"
msgid "Кайенский перец"
msgstr "Cayenne Pepper"

#. Key:	CID_Food_Raw_Pepper_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Pepper_T01_VanityText"
msgid "Жжется как яд морской ведьмы."
msgstr "Burns like a sea witch’s poison."

#. Key:	CID_Food_Raw_Pineapple_T04_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Pineapple_T04_ItemName"
msgid "NOT USED Pineapple"
msgstr "NOT USED Pineapple"

#. Key:	CID_Food_Raw_Tomato_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Tomato_T02_ItemDescription"
msgid "Сочные красные томаты легко найти в Предгорьях. Древние цивилизации культивировали их с давних времен.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Lush red tomatoes. They’ve been cultivated by ancient civilizations for centuries.\r\n\r\nGrow in the Foothills\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Raw_Tomato_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Tomato_T02_ItemName"
msgid "Томат"
msgstr "Tomato"

#. Key:	CID_Food_Raw_Tomato_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_Tomato_T02_VanityText"
msgid "Ядовитые, не ядовитые... Раз жевать можно – сойдет!\r\n— всегда голодный капитан Томас Ричардс"
msgstr "Poisonous, not poisonous... If you can chew it, it’ll do!\r\n— Captain Thomas Richards, perpetually hungry"

#. Key:	CID_Food_Raw_UmbraFruit_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_UmbraFruit_T03_ItemDescription"
msgid "Можно найти в болотах."
msgstr "Found in the Swamps."

#. Key:	CID_Food_Raw_UmbraFruit_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Raw_UmbraFruit_T03_ItemName"
msgid "Дурманящий плод\t"
msgstr "Intoxicating Fruit"

#. Key:	CID_Food_Rum_Bottle_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Rum_Bottle_T03_ItemDescription"
msgid "Лучшая приправа для любого пиратского блюда. Можно найти у пиратов."
msgstr "The finest seasoning for any pirate dish.\r\n\r\nObtained from pirates."

#. Key:	CID_Food_Rum_Bottle_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Rum_Bottle_T03_ItemName"
msgid "Бутылка рома"
msgstr "Rum Bottle"

#. Key:	CID_Food_Rum_Bottle_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Rum_Bottle_T03_VanityText"
msgid "Сегодня закончился ром. Команда несколько протрезвела... У нас чертовский беспорядок! Негодяи пытались устроить заговор...\r\n— Эдвард Тич"
msgstr "Such a Day, rum all out. Our Company somewhat sober. A Damned Confusion amongst us! Rogues a plotting...;\r\n— Edward Teach"

#. Key:	CID_Food_Second_BaconAndEggs_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_BaconAndEggs_T01_ItemDescription"
msgid "Сытный завтрак, приготовленный из свежих яиц и копченого бекона, — идеальное начало дня на райском архипелаге.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A hearty breakfast of fresh eggs and smoked bacon—the perfect start to a day in the Paradise Archipelago.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_BaconAndEggs_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_BaconAndEggs_T01_ItemName"
msgid "Яичница с беконом"
msgstr "Bacon and Eggs"

#. Key:	CID_Food_Second_BaconAndEggs_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_BaconAndEggs_T01_VanityText"
msgid "Редкий завтрак для моряка. Особенно в море."
msgstr "A rare breakfast for a sailor, especially at sea."

#. Key:	CID_Food_Second_BirdOnPotato_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_BirdOnPotato_T01_ItemDescription"
msgid "Очень сытное пряное блюдо, приготовленное из мяса с острыми специями и бататом. Согревает и придает сил.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A hearty, spicy dish of meat, hot spices, and sweet potato. Warms you up and restores your strength.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_BirdOnPotato_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_BirdOnPotato_T01_ItemName"
msgid "Острая \"курица\" с бататом"
msgstr "Spicy “Chicken” with Sweet Potato"

#. Key:	CID_Food_Second_BirdOnPotato_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_BirdOnPotato_T01_VanityText"
msgid "Один укус – и в груди разгорится пламя, а усталость сгорит дотла. Возможно, вместе с гортанью."
msgstr "One bite and your chest will blaze, your weariness burning to ash. Your throat may suffer in the process."

#. Key:	CID_Food_Second_Crab_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_Crab_T01_ItemDescription"
msgid "Простой, но изысканный деликатес.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A simple, but exquisite delicacy.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_Crab_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_Crab_T01_ItemName"
msgid "Вареный краб"
msgstr "Boiled Crab"

#. Key:	CID_Food_Second_Crab_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_Crab_T01_VanityText"
msgid "Пять минут назад он бегал по берегу..."
msgstr "Five minutes ago, it was scuttling along the shore..."

#. Key:	CID_Food_Second_FishAndTostones_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_FishAndTostones_T02_ItemDescription"
msgid "Рыба с дважды обжаренными до золотистого цвета ломтиками бананов. Привычное блюдо на островах Карибского моря.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Fish with golden, twice-fried banana slices. A familiar dish in the Caribbean.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_FishAndTostones_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_FishAndTostones_T02_ItemName"
msgid "Рыба с тостонес"
msgstr "Fish and Tostones"

#. Key:	CID_Food_Second_FishAndTostones_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_FishAndTostones_T02_VanityText"
msgid "Когда ты на суше, рыба и бананы – просто еда. Когда ты в море, это королевский пир."
msgstr "On land, fish and bananas are just food. At sea, it is a royal feast."

#. Key:	CID_Food_Second_MeatSalad_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_MeatSalad_T02_ItemDescription"
msgid "Идеальное блюдо, когда есть немножечко того, немножечко сего и еще чуть-чуть этого. Одна беда – сначала надо как следует погоняться за ингредиентами.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A perfect dish when you have a bit of this, a bit of that, and whatever else you can find. The only trouble is chasing down the ingredients first.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_MeatSalad_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_MeatSalad_T02_ItemName"
msgid "Мясной салат"
msgstr "Meat Salad"

#. Key:	CID_Food_Second_MeatSalad_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_MeatSalad_T02_VanityText"
msgid "Сами свою траву ешьте! А мне дайте мяса!"
msgstr "You eat your grass. I’ll take the meat."

#. Key:	CID_Food_Second_Potatoshrooms_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_Potatoshrooms_T03_ItemDescription"
msgid "Этот рецепт прост в приготовлении и легко утоляет голод. Главное не перепутать грибы.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "This recipe is easy to make, and it fills you up. Just be sure you don’t mix up the mushrooms.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_Potatoshrooms_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_Potatoshrooms_T03_ItemName"
msgid "Фасоль с грибами и бататом"
msgstr "Beans with Mushrooms and Sweet Potato"

#. Key:	CID_Food_Second_Potatoshrooms_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_Potatoshrooms_T03_VanityText"
msgid "Приготовить вкусную еду несложно: достаточно свежих овощей и уверенности, что завтра мы еще будем живы.\r\n— корабельный кок \"Одноглазый\" Аксель"
msgstr "Cooking good food isn’t hard: all you need is fresh vegetables and the confidence that we’ll still be alive tomorrow.\r\n— Black Axel, cook"

#. Key:	CID_Food_Second_ReptileInSwampSauce_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_ReptileInSwampSauce_T03_ItemDescription"
msgid "Обед настоящего охотника: завалил крокодила – сожрал крокодила, залив жесткое мясо смертельно-острой жижей.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A true hunter’s dinner: kill a crocodile, then eat it, dousing the tough meat in lethally hot sauce.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_ReptileInSwampSauce_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_ReptileInSwampSauce_T03_ItemName"
msgid "Мясо крокодила в болотном соусе"
msgstr "Crocodile in Swamp Sauce"

#. Key:	CID_Food_Second_ReptileInSwampSauce_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_ReptileInSwampSauce_T03_VanityText"
msgid "Хочешь знать, как выжить в дикой местности? Съешь того, кто пытался съесть тебя."
msgstr "Want to know how to survive in the wilderness? Eat what tried to eat you."

#. Key:	CID_Food_Second_SeafoodPlatter_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_SeafoodPlatter_T03_ItemDescription"
msgid "Свежие дары моря, символизирующие щедрость океана. Они надолго время позволяют забыть о голоде.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Fresh seafood, a sign of the ocean’s generosity. Keeps hunger away for a long time.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Second_SeafoodPlatter_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_SeafoodPlatter_T03_ItemName"
msgid "Морское ассорти"
msgstr "Seafood Platter"

#. Key:	CID_Food_Second_SeafoodPlatter_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Second_SeafoodPlatter_T03_VanityText"
msgid "Любимое блюдо ловеласов Тортуги."
msgstr "A favorite dish among Tortuga’s most enthusiastic charmers."

#. Key:	CID_Food_Skewer_Bird_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Bird_T01_ItemDescription"
msgid "На вкус как курятина.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Tastes like chicken.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_Bird_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Bird_T01_ItemName"
msgid "Острый шашлык в панировке"
msgstr "Spicy Breaded Kebab"

#. Key:	CID_Food_Skewer_Bird_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Bird_T01_VanityText"
msgid "Настоящий моряк ест мясо с костра, пьет ром из бутылки и спит с ножом под подушкой."
msgstr "A true sailor eats meat off the fire, drinks rum straight from the bottle, and sleeps with a knife under his pillow."

#. Key:	CID_Food_Skewer_Meat_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Meat_T01_ItemDescription"
msgid "Мясо с дымком.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Meat with a hint of smoke.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_Meat_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Meat_T01_ItemName"
msgid "Мясо на палке"
msgstr "Skewered Meat"

#. Key:	CID_Food_Skewer_Meat_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Meat_T01_VanityText"
msgid "Идеальная еда, которая не требует вилки, ножа и манер.\r\n— \"Безрукий\" Флинн, плотник"
msgstr "Perfect food—no fork, no knife, no manners required.\r\n— “No-Hands” Flynn, carpenter"

#. Key:	CID_Food_Skewer_Meatshrooms_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Meatshrooms_T03_ItemDescription"
msgid "Сочные куски мяса, зажаренные на открытом огне, отличаются насыщенным вкусом и ароматом. Соус из лесных грибов придает мясу пикантность.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Tender cuts of meat grilled over an open fire, full of deep flavour and a mouthwatering scent. Wild mushroom sauce gives the meat a savory kick.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_Meatshrooms_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Meatshrooms_T03_ItemName"
msgid "Мясо в кислом грибном соусе"
msgstr "Meat in Tangy Mushroom Sauce"

#. Key:	CID_Food_Skewer_Meatshrooms_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Meatshrooms_T03_VanityText"
msgid "Один укус, чтобы набить желудок, два – для придания сил, три – и можно с голыми руками идти на акулу!\r\n— юнга Тоби, перед тем как прыгнуть за борт"
msgstr "One bite to fill your belly, two to regain your strength—by the third, you can charge a shark with your bare hands!\r\n— Toby, cabin boy, before he jumped overboard"

#. Key:	CID_Food_Skewer_Reptile_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Reptile_T03_ItemDescription"
msgid "Съешь его, и почувствуешь, как силы дикой природы наполняют тело.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Consume it to feel the raw strength of nature flow through you.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_Reptile_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Reptile_T03_ItemName"
msgid "Мясо крокодила на палке"
msgstr "Skewered Crocodile Meat"

#. Key:	CID_Food_Skewer_Reptile_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_Reptile_T03_VanityText"
msgid "Даже самые опасные существа могут однажды совершить ошибку."
msgstr "One day, even the deadliest creatures can make a mistake."

#. Key:	CID_Food_Skewer_SeafoodHarpoon_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SeafoodHarpoon_T02_ItemDescription"
msgid "Вырабатывает терпение и силу воли.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Builds patience and willpower.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_SeafoodHarpoon_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SeafoodHarpoon_T02_ItemName"
msgid "Морской шашлык"
msgstr "Seafood Skewer"

#. Key:	CID_Food_Skewer_SeafoodHarpoon_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SeafoodHarpoon_T02_VanityText"
msgid "В случае неудачи не обвиняй рыбу.\r\n— третье правило рыболова"
msgstr "In case of failure, don’t blame the fish.\r\n— the fisherman’s third rule"

#. Key:	CID_Food_Skewer_SpicyCrab_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SpicyCrab_T01_ItemDescription"
msgid "Эта приправленная специями и запеченная до золотистой корочки тварь утоляет голод и бодрит дух.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Crisp, spiced, and hearty enough to satisfy your hunger and lift your mood.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_SpicyCrab_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SpicyCrab_T01_ItemName"
msgid "Острый краб на палке"
msgstr "Spicy Skewered Crab"

#. Key:	CID_Food_Skewer_SpicyCrab_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SpicyCrab_T01_VanityText"
msgid "Если язык не онемел – значит, повар пожалел специй."
msgstr "If your tongue isn’t numb, the cook went easy on the spices."

#. Key:	CID_Food_Skewer_SpicyReptile_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SpicyReptile_T03_ItemDescription"
msgid "Tender croc meat and delicate striploin, marinated with leek and rare spices. A hearty meal to celebrate making it back to camp without ending up in a croc’s belly.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "Tender croc meat and delicate striploin, marinated with leek and rare spices. A hearty meal to celebrate making it back to camp without ending up in a croc’s belly.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Skewer_SpicyReptile_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SpicyReptile_T03_ItemName"
msgid "Meaty Croc Kebab"
msgstr "Meaty Croc Kebab"

#. Key:	CID_Food_Skewer_SpicyReptile_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Skewer_SpicyReptile_T03_VanityText"
msgid "No \"tick-tock\" anymore."
msgstr "No \"tick-tock\" anymore."

#. Key:	CID_Food_Soup_Bean_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Bean_T03_ItemDescription"
msgid "Густая мясная похлебка с фасолью возвращает силы даже после самой тяжелой вахты.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A hearty meat stew with beans that restores strength even after the toughest watch.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_Bean_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Bean_T03_ItemName"
msgid "Фасолевая похлебка"
msgstr "Bean Soup"

#. Key:	CID_Food_Soup_Bean_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Bean_T03_VanityText"
msgid "В море есть три вещи, которым ты всегда рад: попутный ветер, полный кошель и миска горячей похлебки."
msgstr "There are three things at sea you are always glad to have: a tailwind, a full purse and a bowl of hot soup."

#. Key:	CID_Food_Soup_BirdBroth_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_BirdBroth_T01_ItemDescription"
msgid "Прозрачный супчик, сваренный из мяса додо. Его подают больным, раненым... и морякам после бурной ночи в таверне.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A delicate, crystal-clear broth made from dodo meat. Served to the sick, the wounded… and sailors after a wild night at the tavern.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_BirdBroth_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_BirdBroth_T01_ItemName"
msgid "Бульон из мяса додо"
msgstr "Dodo Broth"

#. Key:	CID_Food_Soup_BirdBroth_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_BirdBroth_T01_VanityText"
msgid "Манящий запах из кипящего котла вернул больше людей с того света, чем любая микстура.\r\n— корабельный кок \"Одноглазый\" Аксель"
msgstr "The tempting smell of a boiling pot has brought more people back from the brink of death than any potion ever could.\r\n— Black Axel, cook"

#. Key:	CID_Food_Soup_BrothWithPotato_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_BrothWithPotato_T02_ItemDescription"
msgid "Сытная похлебка, которую готовят, когда трюм полон запасов, а в рейде команда не дольше недели.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A hearty stew cooked when the hold is full of supplies and the crew’s been at sea for less than a week.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_BrothWithPotato_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_BrothWithPotato_T02_ItemName"
msgid "Сытный бульон с яйцом"
msgstr "Hearty Egg Broth"

#. Key:	CID_Food_Soup_BrothWithPotato_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_BrothWithPotato_T02_VanityText"
msgid "Если на камбузе остался один батат, значит, скоро или порт, или бунт.\r\n— корабельный кок \"Одноглазый\" Аксель"
msgstr "If there’s only one sweet potato left in the galley, we’re nearing either a port or a mutiny.\r\n— Black Axel, cook"

#. Key:	CID_Food_Soup_Chowder_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Chowder_T02_ItemDescription"
msgid "Густой рыбный суп, в который можно положить не только рыбу, но и все, что выловилось вместе с ней.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A rich fish soup where you can toss in not just the fish, but whatever else came up with it.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_Chowder_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Chowder_T02_ItemName"
msgid "Чаудер"
msgstr "Chowder"

#. Key:	CID_Food_Soup_Chowder_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Chowder_T02_VanityText"
msgid "Вся не проданная за день рыба вечером отправляется в суп."
msgstr "Any fish not sold during the day ends up in the evening soup."

#. Key:	CID_Food_Soup_Coconut_T01_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Coconut_T01_ItemDescription"
msgid "Сваренная на молоке тропических кокосов, эта густая похлебка напоминает о жарких берегах даже во время шторма.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "This thick coconut-milk soup brings hot shores to mind—even in a storm.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_Coconut_T01_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Coconut_T01_ItemName"
msgid "Кокосовая похлебка"
msgstr "Coconut Soup"

#. Key:	CID_Food_Soup_Coconut_T01_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Coconut_T01_VanityText"
msgid "На вкус как райский остров, до которого мы никогда не доберемся.\r\n— штурман Билли \"Кривой Компас\""
msgstr "Tastes like a paradise island that we will never reach.\r\n— “Crooked Compass” Billy, navigator"

#. Key:	CID_Food_Soup_Gazpacho_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Gazpacho_T03_ItemDescription"
msgid "Традиционное блюдо андалусской кухни. Легкий холодный суп из перетертых в пюре свежих овощей.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A staple dish in Andalusian cooking. A refreshing chilled soup of pureed fresh vegetables.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_Gazpacho_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Gazpacho_T03_ItemName"
msgid "Гаспачо"
msgstr "Gazpacho"

#. Key:	CID_Food_Soup_Gazpacho_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_Gazpacho_T03_VanityText"
msgid "Гаспачо завезли на Карибы испанцы вместе с христианством и оспой."
msgstr "Gazpacho was brought to the Caribbean by the Spanish along with Christianity and smallpox."

#. Key:	CID_Food_Soup_TomatoCrab_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_TomatoCrab_T02_ItemDescription"
msgid "Этот густой суп, сваренный из свежевыловленного краба и спелых томатов, одинаково хорош и для голодного моряка, и для богатого торговца.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "This thick soup, made from freshly caught crab and ripe tomatoes, is equally suited to a hungry sailor and a wealthy merchant alike.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Soup_TomatoCrab_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_TomatoCrab_T02_ItemName"
msgid "Крабовый суп с кусочками томатов"
msgstr "Crab Soup with Diced Tomatoes"

#. Key:	CID_Food_Soup_TomatoCrab_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Soup_TomatoCrab_T02_VanityText"
msgid "Его аромат собирает всю команду у котла быстрее, чем крик \"земля на горизонте!\"."
msgstr "Its aroma gathers the whole crew around the cauldron faster than a cry of “Land ahoy!”"

#. Key:	CID_Food_Sweet_CakeIcaco_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CakeIcaco_T03_ItemDescription"
msgid "Нежный и ароматный пирог, чьи ингредиенты стоят как полгалеона и мортира в придачу.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A delicate, fragrant pie made from ingredients that cost half a galleon, plus a mortar on top of that.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Sweet_CakeIcaco_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CakeIcaco_T03_ItemName"
msgid "Болотный пирог"
msgstr "Swamp Pie"

#. Key:	CID_Food_Sweet_CakeIcaco_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CakeIcaco_T03_VanityText"
msgid "...А услуги повара – еще полгалеона."
msgstr "...And the chef to cook it will cost you another half a galleon."

#. Key:	CID_Food_Sweet_CakePeanut_T03_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CakePeanut_T03_ItemDescription"
msgid "Редкое лакомство, которому слива придает свежий сладковатый аромат, а орехи – сытности.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A rare delight infused with the fresh sweetness of plum and the rich fullness of nuts.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Sweet_CakePeanut_T03_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CakePeanut_T03_ItemName"
msgid "Ореховый пирог"
msgstr "Cocoplum Pie"

#. Key:	CID_Food_Sweet_CakePeanut_T03_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CakePeanut_T03_VanityText"
msgid "Хрустя орехами, берегите зубы!"
msgstr "Crunch carefully—mind your teeth!"

#. Key:	CID_Food_Sweet_CornRoll_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CornRoll_T02_ItemDescription"
msgid "Насыщеный рулет с нежным ореховым вкусом.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A rich pastry roll with a delicate nutty flavor.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Sweet_CornRoll_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CornRoll_T02_ItemName"
msgid "Ореховый рулет"
msgstr "Tangy Nut Roll"

#. Key:	CID_Food_Sweet_CornRoll_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CornRoll_T02_VanityText"
msgid "Оставляет после себя приятное послевкусие, как память о былых приключениях."
msgstr "It leaves a tart aftertaste, a vivid reminder of former adventures."

#. Key:	CID_Food_Sweet_CupcakeBanana_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CupcakeBanana_T02_ItemDescription"
msgid "Сладкий и сочный кекс, приготовленный из спелых бананов.\r\n\r\nУвеличивает максимальное ХП\r\nДействует {0} минут"
msgstr "A sweet, moist muffin made from ripe bananas.\r\n\r\nIncreases Maximum Health.\r\nLasts {0} minutes."

#. Key:	CID_Food_Sweet_CupcakeBanana_T02_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CupcakeBanana_T02_ItemName"
msgid "Банановый кекс"
msgstr "Banana Muffin"

#. Key:	CID_Food_Sweet_CupcakeBanana_T02_VanityText
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_CupcakeBanana_T02_VanityText"
msgid "Из гнилых бананов выходит не очень вкусно."
msgstr "It does not taste as good when made with rotten bananas."

#. Key:	CID_Food_Sweet_PineapplePie_T04_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_PineapplePie_T04_ItemDescription"
msgid "NOT USED Pineapple Pie"
msgstr "NOT USED Pineapple Pie"

#. Key:	CID_Food_Sweet_PineapplePie_T04_ItemName
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Food_Sweet_PineapplePie_T04_ItemName"
msgid "NOT USED Pineapple Pie"
msgstr "NOT USED Pineapple Pie"

#. Key:	CID_Misc_CultistNoteBlood_T02_ItemDescription
#. SourceLocation:	Localization/Data/InventoryItems.csv
#: Localization/Data/InventoryItems.csv
msgctxt "InventoryItems,CID_Misc_CultistNoteBlood_T02_ItemDescription"
msgid "Когда-то это была карта сокровищ, но время и море ее не пощадили\r\n"
