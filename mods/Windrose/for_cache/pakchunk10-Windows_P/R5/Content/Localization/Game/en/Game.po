#. Key:	Settings_Description_3DResolution
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_3DResolution"
msgid "The game is rendered at this resolution. It does not affect the UI. Higher values improve image sharpness. Warning: setting this too high may significantly reduce frame rate and increase GPU load."
msgstr "The game is rendered at this resolution. It does not affect the UI. Higher values improve image sharpness. Warning: setting this too high may significantly reduce frame rate and increase GPU load."

#. Key:	Settings_Description_Ambient
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_Ambient"
msgid "Adjust the volume of Ambient"
msgstr "Adjusts the ambient volume"

#. Key:	Settings_Description_AntiAliasing
