msgstr "Changes your field of view setting."

#. Key:	Settings_Description_FrameRateLimit
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_FrameRateLimit"
msgid "Set Frame Rate Limit"
msgstr "Set Frame Rate Limit"

#. Key:	Settings_Description_GenerationType
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_GenerationType"
msgid "Creates intermediate frames to improve frame rate and smoothness. For best results, make sure your monitor refresh rate and in-game frame limit are set above 60 Hz."
msgstr "Creates intermediate frames to improve frame rate and smoothness. For best results, make sure your monitor refresh rate and in-game frame limit are set above 60 Hz."

#. Key:	Settings_Description_GraphicsQualityPresets
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_GraphicsQualityPresets"
msgid "Quality Preset allows you to adjust multiple video options at once. Try a few options to see what fits your preference and device's performance."
msgstr "Quality Presets allow you to adjust multiple video options at once. Try a few options to see what fits your preference and device performance."

#. Key:	Settings_Description_HardwareAcceleratedScheduling
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_HardwareAcceleratedScheduling"
msgid "Required Hardware Acceleration Scheduling to ON"
msgstr "Required Hardware Acceleration Scheduling to ON"

#. Key:	Settings_Description_HDR
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
