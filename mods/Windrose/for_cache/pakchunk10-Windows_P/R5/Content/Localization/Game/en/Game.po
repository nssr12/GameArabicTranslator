#. Key:	Ship_Customization_Flag_BlackBeard_Altered_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Altered_Description"
msgid "Все, кто видят этот флаг, понимают, что их ждет неминуемая смерть при сопротивлении."
msgstr "Anyone who sees this flag knows: resist, and death is certain."

#. Key:	Ship_Customization_Flag_BlackBeard_Altered_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Altered_Name"
msgid "Охотник за сердцами"
msgstr "Heart Reaper"

#. Key:	Ship_Customization_Flag_BlackBeard_Bonnet_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Bonnet_Description"
msgid "Череп означает пиратский корабль, кость между сердцем и кинжалом – качели между жизнью и смертью. Символизирует шаткое положение любого, кто оказался в море."
msgstr "The skull stands for a pirate ship. The bone between the heart and the dagger is a scale between life and death—an omen of how fragile anyone’s fate is at sea."

#. Key:	Ship_Customization_Flag_BlackBeard_Bonnet_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Bonnet_Name"
msgid "Флаг Стида Боннета"
msgstr "Stede Bonnet’s Flag"

#. Key:	Ship_Customization_Flag_BlackBeard_Crawler_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Crawler_Description"
msgid "Символ неумолимой смерти. Говорят, что пираты, которые ходили под этим флагом, закапывали своих жертв на берегу по самую шею и смотрели, как их поедают животные... или прилив."
msgstr "A symbol of inexorable death. They say the pirates who sailed under this flag buried their victims up to the neck on the shore and watched in grim amusement as animals gathered… or the tide crept in"

#. Key:	Ship_Customization_Flag_BlackBeard_Crawler_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Crawler_Name"
msgid "Медленная смерть"
msgstr "Lingering Death"

#. Key:	Ship_Customization_Flag_BlackBeard_Origin_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Origin_Description"
msgid "В одной руке скелет держит песочные часы, в другой – копье, нацеленное на сердце с каплями крови."
msgstr "In one hand, the skeleton holds an hourglass; in the other, a spear aimed at a bleeding heart."

#. Key:	Ship_Customization_Flag_BlackBeard_Origin_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_BlackBeard_Origin_Name"
msgid "Флаг Черной Бороды"
msgstr "Blackbeard's Flag"

#. Key:	Ship_Customization_Flag_Brethren_Altered_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Altered_Description"
msgid "Символ воли к свободе и презрения к смерти."
msgstr "A symbol of freedom and defiance of death."

#. Key:	Ship_Customization_Flag_Brethren_Altered_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Altered_Name"
msgid "Веселый Роджер"
msgstr "Jolly Roger"

#. Key:	Ship_Customization_Flag_Brethren_Axes_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Axes_Description"
msgid "Флаг Берегового Братства с изображением головы чудовища и двумя топорами. Подходит капитанам, которые не боятся противостоять самым опасным монстрам."
msgstr "Brethren of the Coast Flag — bearing a monster’s head and two axes. Suits captains unafraid to face the deadliest horrors of the sea."

#. Key:	Ship_Customization_Flag_Brethren_Axes_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Axes_Name"
msgid "Левиафан"
msgstr "Leviathan"

#. Key:	Ship_Customization_Flag_Brethren_Origin_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Origin_Description"
msgid "Веселый Роджер с кинжалом в зубах и перекрещенными саблями позади. Враг видит и дрожит."
msgstr "A Jolly Roger with a dagger clenched in its teeth and crossed sabers behind. Enemies see it—and tremble."

#. Key:	Ship_Customization_Flag_Brethren_Origin_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Origin_Name"
msgid "Флаг Берегового Братства"
msgstr "Brethren of the Coast Flag"

#. Key:	Ship_Customization_Flag_Brethren_Raven_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Raven_Description"
msgid "Все мы однажды станем пищей воронья или морских чудищ. Но противники этого капитана станут ею раньше других."
msgstr "One day, every soul feeds the ravens—or the monsters below. This captain just makes sure his foes are served first."

#. Key:	Ship_Customization_Flag_Brethren_Raven_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Brethren_Raven_Name"
msgid "Ворон"
msgstr "Raven"

#. Key:	Ship_Customization_Flag_Buccaneers_Altered_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Altered_Description"
msgid "Символ того, что дни ваших врагов сочтены."
msgstr "A sign that your enemies’ days are numbered."

#. Key:	Ship_Customization_Flag_Buccaneers_Altered_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Altered_Name"
msgid "Меткий стрелок"
msgstr "Deadeye"

#. Key:	Ship_Customization_Flag_Buccaneers_Cannons_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Cannons_Description"
msgid "У буканьеров даже пушки стреляют точно в цель."
msgstr "Give a Buccaneer a cannon, and they’ll still hit the target."

#. Key:	Ship_Customization_Flag_Buccaneers_Cannons_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Cannons_Name"
msgid "Тяжелая артиллерия"
msgstr "Big Guns"

#. Key:	Ship_Customization_Flag_Buccaneers_Origin_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Origin_Description"
msgid "Два скрещенных ружья с песочными часами и черепом."
msgstr "Two crossed muskets with an hourglass and a skull."

#. Key:	Ship_Customization_Flag_Buccaneers_Origin_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Origin_Name"
msgid "Флаг буканьеров"
msgstr "Rogue Buccaneer's Flag"

#. Key:	Ship_Customization_Flag_Buccaneers_Pistols_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Pistols_Description"
msgid "Флаг олицетворяет меткость и мастерство. Ни один враг не уйдет."
msgstr "A symbol of marksmanship and expertise. No enemy will escape."

#. Key:	Ship_Customization_Flag_Buccaneers_Pistols_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Buccaneers_Pistols_Name"
msgid "Верные пистоли"
msgstr "Faithful Pistols"

#. Key:	Ship_Customization_Flag_Smugglers_Altered_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Altered_Description"
msgid "Кто не рискует, тот упускает шанс разбогатеть."
msgstr "Fortune favors the brave—play it safe, and you’ll die poor."

#. Key:	Ship_Customization_Flag_Smugglers_Altered_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Altered_Name"
msgid "Цена риска"
msgstr "Price of a Gamble"

#. Key:	Ship_Customization_Flag_Smugglers_Origin_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Origin_Description"
msgid "Весы, на одной стороне которых достаток, а на другой – смерть. Что перевесит?"
msgstr "Wealth or death—what will outweigh the other?"

#. Key:	Ship_Customization_Flag_Smugglers_Origin_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Origin_Name"
msgid "Флаг контрабандистов"
msgstr "Smugglers of Port Royal Flag"

#. Key:	Ship_Customization_Flag_Smugglers_Pisces_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Pisces_Description"
msgid "Символ упорства и успеха на далеком Востоке. Согласно преданию карп, который плывет против течения и преодолевает водопад, превращается в дракона."
msgstr "In the Far East, it symbolizes grit and good fortune. Legend tells of a koi that fights the current, conquers a waterfall—and becomes a dragon."

#. Key:	Ship_Customization_Flag_Smugglers_Pisces_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Pisces_Name"
msgid "Волшебные карпы"
msgstr "Mystic Koi"

#. Key:	Ship_Customization_Flag_Smugglers_Snake_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Snake_Description"
msgid "Флаг, который ясно дает понять, что не стоит переходить дорогу тем, у кого кинжалы смазаны ядом."
msgstr "A flag that makes one thing clear: don’t cross those whose daggers are coated in poison."

#. Key:	Ship_Customization_Flag_Smugglers_Snake_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Smugglers_Snake_Name"
msgid "Мудрый змей"
msgstr "Wise Serpent"

#. Key:	Ship_Customization_Flag_Stock_EICo_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_EICo_Description"
msgid "Иногда выгодно притвориться кем-то другим..."
msgstr "Sometimes it pays to pretend to be someone else…"

#. Key:	Ship_Customization_Flag_Stock_EICo_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_EICo_Name"
msgid "Флаг Британской Ост-Индской компании"
msgstr "British East India Company’s Flag"

#. Key:	Ship_Customization_Flag_Stock_LongBen_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_LongBen_Description"
msgid "Флаг легендарного пирата, который завоевал несметные богатства и исчез. Возможно, принесет удачу еще одному капитану."
msgstr "The flag of a legendary pirate who seized untold riches—then vanished. Perhaps it will bring luck to another captain."

#. Key:	Ship_Customization_Flag_Stock_LongBen_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_LongBen_Name"
msgid "Флаг Генри Эвери"
msgstr "Henry Every’s Flag"

#. Key:	Ship_Customization_Flag_Stock_Origin_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_Origin_Description"
msgid "Флаг без опознавательных знаков. Годится тем, кто не хочет принимать чью-либо сторону."
msgstr "A flag with no markings. For those who refuse to take sides."

#. Key:	Ship_Customization_Flag_Stock_Origin_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_Origin_Name"
msgid "Черный флаг"
msgstr "Black Flag"

#. Key:	Ship_Customization_Flag_Stock_Tortuga_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_Tortuga_Description"
msgid "Скрещенные кости на фоне крепости Тортуги."
msgstr "Crossbones against the backdrop of Tortuga’s fortress."

#. Key:	Ship_Customization_Flag_Stock_Tortuga_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_Flag_Stock_Tortuga_Name"
msgid "Флаг капитанов Тортуги"
msgstr "Captains of Tortuga Flag"

#. Key:	Ship_Customization_HullCollor_BlackBeard_Altered_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_Altered_Description"
msgid "Ночью корпус сливается с темнотой, оставляя лишь призрачный контур. Идеально для внезапных атак под покровом ночи."
msgstr "By night the hull melts into shadow, leaving only a phantom silhouette. Ideal for ambushes in the dark."

#. Key:	Ship_Customization_HullCollor_BlackBeard_Altered_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_Altered_Name"
msgid "Буря на горизонте"
msgstr "Storm on the Horizon"

#. Key:	Ship_Customization_HullCollor_BlackBeard_BogWood_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_BogWood_Description"
msgid "Краска настолько темная и насыщенная, будто корпус был вымазан чернилами чудовищ из морских глубин."
msgstr "The paint is so dark and rich that the hull seems coated in ink from monsters of the ocean depths."

#. Key:	Ship_Customization_HullCollor_BlackBeard_BogWood_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_BogWood_Name"
msgid "Чернила осьминога"
msgstr "Kraken Ink"

#. Key:	Ship_Customization_HullCollor_BlackBeard_Origin_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_Origin_Description"
msgid "Стандартная краска для кораблей Черной Бороды. Вместе с другими пиратскими атрибутами смотрится устрашающе."
msgstr "The standard paint used on Blackbeard’s ships. Looks especially fearsome alongside other pirate gear."

#. Key:	Ship_Customization_HullCollor_BlackBeard_Origin_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_Origin_Name"
msgid "Аметистовый шквал"
msgstr "Amethyst Squall"

#. Key:	Ship_Customization_HullCollor_BlackBeard_Renewed_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_Renewed_Description"
msgid "Редкая и дорогая краска, которую видно за мили. Для тех, кто открыто бросает вызов морю, врагам и даже империям."
msgstr "A rare, costly paint visible for miles. For captains bold enough to challenge the sea, their enemies, and empires alike."

#. Key:	Ship_Customization_HullCollor_BlackBeard_Renewed_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_BlackBeard_Renewed_Name"
msgid "Королевский пурпур"
msgstr "Tyrian Purple"

#. Key:	Ship_Customization_HullCollor_Brethren_Altered_Description
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_Brethren_Altered_Description"
msgid "Насыщенная краска для корпуса кораблей Берегового Братства. Для выдающихся капитанов."
msgstr "A rich hull paint used by the Brethren of the Coast. Reserved for distinguished captains."

#. Key:	Ship_Customization_HullCollor_Brethren_Altered_Name
#. SourceLocation:	Localization/Data/ShipItems.csv
#: Localization/Data/ShipItems.csv
msgctxt "ShipItems,Ship_Customization_HullCollor_Brethren_Altered_Name"
