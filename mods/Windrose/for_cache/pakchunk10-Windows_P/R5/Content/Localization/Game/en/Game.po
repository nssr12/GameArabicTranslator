msgstr "The game language."

#. Key:	Settings_Description_LeftStickZone
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_LeftStickZone"
msgid "Increase or decrease the area surrounding the stick that we ignore input from.  Setting this value too low may result in the character continuing to move even after removing your finger from the stick."
msgstr "Adjusts the stick dead zone (the area where input is ignored). Setting it too low may cause the character to keep moving after you release the stick."

#. Key:	Settings_Description_LookSensitivity
#. SourceLocation:	Localization/Data/Settings.csv
#: Localization/Data/Settings.csv
msgctxt "Settings,Settings_Description_LookSensitivity"
